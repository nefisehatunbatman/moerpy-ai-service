# Run scripts/configure_demo.py to generate a private secret and select the large dataset.
ENVIRONMENT=development
REPORTING_TIMEZONE=Europe/Istanbul
AI_SERVICE_API_PREFIX=/api/v1
AI_SERVICE_LOG_LEVEL=INFO
# Required for ALL API calls together with signed tenant/company/actor context.
# Empty means NOT READY; it never turns authentication off.
AI_SERVICE_INTERNAL_TOKEN=
CONTEXT_MAX_AGE_SECONDS=120
MAX_REQUEST_BYTES=32768
MAX_CONCURRENT_REQUESTS=8

# Main 24-month business corpus, indexed by python -m app.data.business.
ERP_PROVIDER=business
BUSINESS_DATASET_DB=./data/business_24m.db
ERP_DATABASE_URL=
AI_SERVICE_DATABASE_URL=sqlite:///./data/service_v2.db
INVENTORY_MAX_AGE_DAYS=7

# Explicit modes prevent accidental paid calls during local demos/tests.
LLM_MODE=offline
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=20
LLM_MAX_TOKENS=1600

EMBEDDING_MODE=local
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BASE_URL=https://api.openai.com/v1
RAG_MIN_SIMILARITY=0.15
